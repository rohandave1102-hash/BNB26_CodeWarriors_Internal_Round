            <span>{route.label}</span>
            {route.badge && (
              <span style={{
                fontSize: '0.6rem',
                padding: '2px 6px',
                borderRadius: '999px',
                background: isActive ? 'rgba(3, 3, 10, 0.3)' : 'rgba(0, 240, 255, 0.2)',
                color: isActive ? '#03030a' : 'var(--neon-cyan)',
                fontWeight: 800,
                letterSpacing: '0.04em'
              }}>
                {route.badge}
              </span>
            )}
          </button>
        );
      })}
    </div>
  );
}
