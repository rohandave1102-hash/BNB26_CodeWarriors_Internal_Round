<file path="frontend/src/index.css">
@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Outfit:wght@300;400;500;600;700;800;900&display=swap');

:root {
  /* Holographic Obsidian Futuristic Palette */
  --bg-space: #03030a;
  --bg-surface: #090915;
  --bg-card: rgba(14, 14, 26, 0.72);
  --bg-card-hover: rgba(22, 22, 40, 0.85);

  --border-subtle: rgba(255, 255, 255, 0.08);
  --border-hologram: rgba(0, 240, 255, 0.35);
  
  /* Luminous Cyber Accents */
  --neon-cyan: #00f0ff;
  --neon-cyan-glow: rgba(0, 240, 255, 0.35);
  --neon-emerald: #00ff88;
  --neon-emerald-glow: rgba(0, 255, 136, 0.35);
  --neon-purple: #8b5cf6;
  --neon-purple-glow: rgba(139, 92, 246, 0.35);
  --neon-magenta: #ff007f;
  --neon-magenta-glow: rgba(255, 0, 127, 0.35);
  --neon-amber: #ffaa00;

  --text-main: #f8fafc;
  --text-muted: #94a3b8;
  --text-dim: #64748b;

  --font-display: 'Outfit', sans-serif;
  --font-sans: 'Space Grotesk', -apple-system, sans-serif;
  --font-mono: 'JetBrains Mono', monospace;
  
  --radius-sm: 10px;
  --radius-md: 18px;
  --radius-lg: 26px;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  background-color: var(--bg-space);
  color: var(--text-main);
  font-family: var(--font-sans);
  min-height: 100vh;
  overflow-x: hidden;
  position: relative;
  /* Holographic Nebula Multi-Layer Background */
  background-image: 
    radial-gradient(circle at 15% 15%, rgba(0, 240, 255, 0.09) 0%, transparent 45%),
    radial-gradient(circle at 85% 20%, rgba(139, 92, 246, 0.12) 0%, transparent 50%),
    radial-gradient(circle at 50% 85%, rgba(0, 255, 136, 0.07) 0%, transparent 50%),
    radial-gradient(circle at 80% 80%, rgba(255, 0, 127, 0.06) 0%, transparent 45%);
  background-attachment: fixed;
}

/* Perspective Cyber Scanline & Grid */
body::before {
  content: "";
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-size: 60px 60px;
  background-image: 
    linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
  pointer-events: none;
  z-index: 0;
}

/* Custom Interactive Cyber-Cursor */
.custom-cursor {
  position: fixed;
  width: 9px;
  height: 9px;
  background-color: var(--neon-cyan);
  border-radius: 50%;
  pointer-events: none;
  z-index: 9999;
  transition: transform 0.12s ease-out, background-color 0.2s ease;
  box-shadow: 0 0 14px var(--neon-cyan);
}

.cursor-follower {
  position: fixed;
  width: 36px;
  height: 36px;
  border: 1.5px solid rgba(0, 240, 255, 0.4);
  border-radius: 50%;
  pointer-events: none;
  z-index: 9998;
  transition: transform 0.22s ease-out, border-color 0.2s ease;
}

/* 3D Glassmorphism Cards with Holographic Edging */
.glass-3d {
  background: var(--bg-card);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid var(--border-subtle);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.08);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease, border-color 0.3s ease;
  position: relative;
  overflow: hidden;
}

.glass-3d::after {
  content: "";
  position: absolute;
  top: 0;
  left: -100%;
  width: 60%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.04), transparent);
  transform: skewX(-25deg);
  transition: left 0.75s ease;
  pointer-events: none;
}

.glass-3d:hover {
  transform: translateY(-4px) perspective(1000px) rotateX(1deg) rotateY(-1deg);
  border-color: rgba(0, 240, 255, 0.3);
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5), 0 0 25px rgba(0, 240, 255, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.12);
}

.glass-3d:hover::after {
  left: 180%;
}

/* Cyber Buttons */
.btn-cyber {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-family: var(--font-sans);
  cursor: pointer;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  overflow: hidden;
  user-select: none;
}

.btn-cyber:hover {
  transform: translateY(-2px);
  filter: brightness(1.12);
}

.btn-cyber:active {
  transform: translateY(0);
}

/* Interactive Dropzone */
.dropzone-cyber {
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.dropzone-cyber:hover {
  border-color: var(--neon-cyan) !important;
  background: rgba(0, 240, 255, 0.04) !important;
  box-shadow: 0 0 25px rgba(0, 240, 255, 0.12);
}

/* Floating Bottom Navigation Dock */
.floating-dock {
  position: fixed;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 12px;
  border-radius: 9999px;
  background: rgba(8, 8, 18, 0.85);
  backdrop-filter: blur(28px);
  -webkit-backdrop-filter: blur(28px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), 0 0 30px rgba(0, 240, 255, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.15);
  z-index: 1000;
  max-width: 95vw;
  overflow-x: auto;
}

.dock-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  border-radius: 9999px;
  background: transparent;
  color: var(--text-muted);
  border: none;
  font-family: var(--font-sans);
  font-size: 0.82rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.22s ease;
  white-space: nowrap;
}

.dock-item:hover {
  color: #fff;
  background: rgba(255, 255, 255, 0.06);
}

.dock-item.active {
  background: linear-gradient(135deg, #00f0ff 0%, #8b5cf6 100%);
  color: #03030a;
  font-weight: 800;
  box-shadow: 0 0 20px rgba(0, 240, 255, 0.45);
}

/* Custom Scrollbar */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: var(--bg-space);
}

::-webkit-scrollbar-thumb {
  background: rgba(0, 240, 255, 0.25);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--neon-cyan);
}

/* Pulse animation */
@keyframes pulseGlow {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.55;
    transform: scale(1.15);
  }
}

@keyframes floatOrbs {
  0%, 100% {
    transform: translateY(0) scale(1);
  }
  50% {
    transform: translateY(-20px) scale(1.05);
  }
}
</file>

