          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(280px, 1fr))', gap: '20px', alignItems: 'center' }}>
            {elaResult.elaHeatmapBase64 && (
              <img
                src={elaResult.elaHeatmapBase64}
