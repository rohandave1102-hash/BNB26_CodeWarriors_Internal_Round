              padding: '12px 16px',
              borderRadius: 'var(--radius-sm)',
              background: 'rgba(3, 7, 18, 0.7)',
              border: '1px solid var(--border-subtle)',
              color: 'var(--neon-emerald)',
              fontFamily: 'var(--font-mono)',
              fontSize: '0.85rem'
