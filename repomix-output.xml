          {filePreview ? (
            <div style={{ textAlign: 'center' }}>
              <img src={filePreview} alt="Preview" style={{ maxHeight: '160px', borderRadius: '12px', marginBottom: '10px' }} />
              <div style={{ color: '#fff', fontWeight: 600 }}>{file?.name}</div>
            </div>
